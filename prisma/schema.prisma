generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String?
  modules     Module[]
  createdAt   DateTime @default(now())
}

model Module {
  id          Int      @id @default(autoincrement())
  title       String
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}